# .gitignore

# Python and uv artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Extra working trees (see docs/roadmap/ROADMAP.md, "Worktree strategy")
.worktrees/

# Environment files: configuration and keys live outside the repository
.env
.env.*

# roadmodel planning kit: the operator context is personal; every kit export
# copies it from ~/.config/roadmodel/user-context.md. Never commit it.
planning/user-context.md

# Local version 1 data (recorded responses, generated reports, logs, state).
# It must never be committed. The leading slash anchors each entry to the
# repository root, so a `cache/` or `state/` directory elsewhere in the tree
# (a fixture directory, for instance) is not ignored by accident.
/cache/
/reports/
/logs/
/state/

# Weatherbot's SQLite database and its WAL and shared-memory files live in the user
# data directory; these guard a WEATHERBOT_DATA_DIR that points into the checkout.
*.sqlite3
*.sqlite3-*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Built web frontend bundle (populated by npm --prefix web run build; shipped in Step 7)
/src/weatherbot/web/static/
